{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JS Agent",
  "version": "0.1.0",
  "identifier": "com.titan.js-agent",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JS Agent",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "url": "recovery.html",
        "create": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/js-agent-host"],
    "icon": ["icons/icon.icns"],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
