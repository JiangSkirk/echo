# JS Agent 环境变量示例
# 复制为 .env 并根据需要修改

# ── 核心路径 ──
# JS_CONFIG_PATH=~/.config/js/config.yaml
# JS_STATE_DIR=~/.js/state

# ── 安全配置 ──
# JS_API_KEY_REQUIRED=true          # 设为 false 关闭 Web API 认证（仅本地开发）
# JS_ALLOW_PRIVATE_MODEL_PROVIDERS=false  # 允许连接局域网模型（RFC1918）
# JS_SECURITY__NETWORK_ENABLED=false       # 工具网络默认关闭
# JS_SECURITY__NETWORK_ALLOWLIST='["example.com"]'  # 仅允许精确公共域名
# JS_MASTER_KEY=                      # 手动指定 Fernet 主密钥（推荐生产环境）

# ── Echo 2.0 架构 ──
# 默认不需要设置：未设置时等同于 JS_ECHO_ENGINE=on
# JS_ECHO_ENGINE=on                  # Echo 2.0 primary，默认架构
# JS_ECHO_LEDGER__RETAIN_RECORDS=10000
# JS_ECHO_LEDGER__TRIGGER_RECORDS=20000
# JS_ECHO_LEDGER__MAX_ARCHIVES=1
# off/shadow 旧架构回滚模式已移除；设置这些值会启动失败
# JS_ECHO_ALLOW_VISION_MODEL_UPLOADS=0  # Echo on-mode 默认阻断 vision 上传

# ── 模型 Provider 配置 ──
# 通过嵌套分隔符 __ 配置子字段，例如：
# JS_PROVIDERS__0__NAME=deepseek
# JS_PROVIDERS__0__BASE_URL=https://api.deepseek.com/v1
# JS_PROVIDERS__0__API_KEY=sk-...
# JS_PROVIDERS__0__MODELS__0__ID=deepseek-chat

# ── 桌面控制 (macOS) ──
# JS_DESKTOP_CONTROL_ENABLED=false

# ── WebBridge 令牌 ──
# JS_WEBRIDGE_TOKEN=                  # 与 WebBridge daemon 共享的认证令牌

# ── CORS / 部署 ──
# JS_ALLOWED_ORIGINS=                 # 逗号分隔的允许来源，如 https://example.com

# ── 开发调试 ──
# JS_WARM_START=true                  # 启动时预热加载 skills 和 provider
